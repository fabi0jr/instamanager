// Contrato da API: docs/api.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TrocaTipo {
  SAIR
  ASSUMIR
}

enum TrocaStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  avatarPath   String?
  isAdmin      Boolean  @default(false)
  pushEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now())

  club          Club?
  sessions      Session[]
  resets        PasswordReset[]
  tenures       CoachTenure[]
  posts         Post[]
  likes         Like[]
  comments      Comment[]
  transfers     TransferRequest[]
  subscriptions PushSubscription[]
  favorites     PromptFavorite[]
  hiddenPosts   HiddenPost[]
  reports       Report[]
  votacoes      Votacao[]
  votos         Voto[]
  stories       Story[]
  storiesVistos StoryVisto[]
  recebidas     Notificacao[] @relation("NotificacaoDestino")
  geradas       Notificacao[] @relation("NotificacaoAtor")
}

model Session {
  id        String   @id // sha256 do token do cookie
  userId    String   @db.Uuid
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  tokenHash String    @id
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Club {
  id        String  @id // slug, ex. "palmeiras"
  name      String
  crestPath String
  bio       String? // até 300, editada pelo técnico
  coverPath String? // capa JPEG (/uploads/capas/…)
  oficial   Boolean @default(false) // CBF: sem técnico, fora de listas livres, cadastro, trocas e tabela
  coachId   String? @unique @db.Uuid // único: um técnico por clube e um clube por pessoa
  coach     User?   @relation(fields: [coachId], references: [id], onDelete: SetNull)

  tenures   CoachTenure[]
  posts     Post[]
  stories   Story[]
  transfers TransferRequest[]
  mandante  Jogo[]            @relation("mandante")
  visitante Jogo[]            @relation("visitante")
  selos     Selo[]
}

// 38 rodadas (criadas na migração). A tabela é calculada dos jogos de rodadas fechadas.
model Rodada {
  numero    Int       @id
  fechadaEm DateTime?
  jogos     Jogo[]
  // post do resumo da CBF (null = ainda não publicado); se o post for apagado, a rodada volta a aceitar resumo
  resumoPostId String? @db.Uuid
  resumoPost   Post?   @relation(fields: [resumoPostId], references: [id], onDelete: SetNull)
}

model Jogo {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rodadaNumero  Int
  mandanteId    String
  visitanteId   String
  golsMandante  Int
  golsVisitante Int
  rodada        Rodada @relation(fields: [rodadaNumero], references: [numero], onDelete: Cascade)
  mandante      Club   @relation("mandante", fields: [mandanteId], references: [id])
  visitante     Club   @relation("visitante", fields: [visitanteId], references: [id])

  @@unique([rodadaNumero, mandanteId])
  @@unique([rodadaNumero, visitanteId])
}

model CoachTenure {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String
  userId    String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  club      Club      @relation(fields: [clubId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId, startedAt])
}

model Post {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resumoDe  Rodada[]
  notificacoes Notificacao[]
  clubId    String
  authorId  String    @db.Uuid // técnico que publicou
  caption   String
  texto     String? // post só de texto (1–500); null = post com imagens
  pinnedAt  DateTime? // fixado no topo do feed (máx. 3)
  hiddenAt  DateTime? // ocultado pelo admin (reversível; só o admin vê)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  club      Club      @relation(fields: [clubId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])

  images   PostImage[]
  video    PostVideo?
  likes    Like[]
  comments Comment[]
  hiddenBy HiddenPost[]
  reports  Report[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([clubId, createdAt(sort: Desc)])
}

model PostImage {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String           @db.Uuid
  position  Int
  fullPath  String
  thumbPath String
  width     Int
  height    Int
  prompt    String?
  post      Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  favorites PromptFavorite[]

  @@unique([postId, position])
}

model Like {
  postId String @db.Uuid
  userId String @db.Uuid
  emoji  String @default("❤️") // a curtida da v1 é a reação ❤️
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String    @db.Uuid
  userId    String    @db.Uuid
  text      String
  hiddenAt  DateTime? // ocultado pelo admin
  createdAt DateTime  @default(now())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports   Report[]
  notificacoes Notificacao[]

  @@index([postId, createdAt])
}

model TransferRequest {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @db.Uuid
  kind      TrocaTipo
  clubId    String?
  status    TrocaStatus @default(PENDENTE)
  createdAt DateTime    @default(now())
  decidedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club?       @relation(fields: [clubId], references: [id])
  avisos    Notificacao[]

  @@index([status, createdAt])
}

model PushSubscription {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String @db.Uuid
  endpoint String @unique
  p256dh   String
  auth     String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id
  value String
}

model PromptFavorite {
  userId    String    @db.Uuid
  imageId   String    @db.Uuid
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  image     PostImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([userId, imageId])
}

/// "Ocultar para mim": o post some só da lista de quem ocultou.
model HiddenPost {
  userId String @db.Uuid
  postId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  postId      String?   @db.Uuid
  commentId   String?   @db.Uuid
  motivo      String? // até 300
  createdAt   DateTime  @default(now())
  resolvidaEm DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([resolvidaEm, createdAt])
}

enum VotacaoTipo {
  CLUBE
  TECNICO
  POST
}

// `opcoes`: lista de ids (clube, usuário técnico ou post, conforme o tipo). Voto secreto até encerrar.
model Votacao {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo      String
  tipo        VotacaoTipo
  opcoes      Json
  prazo       DateTime
  encerradaEm DateTime?
  criadaPor   String      @db.Uuid
  createdAt   DateTime    @default(now())
  criador     User        @relation(fields: [criadaPor], references: [id], onDelete: Cascade)
  votos       Voto[]
  selos       Selo[]
  notificacoes Notificacao[]
}

model Voto {
  votacaoId String  @db.Uuid
  userId    String  @db.Uuid
  opcao     String
  votacao   Votacao @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([votacaoId, userId])
}

model Selo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String
  titulo    String
  votacaoId String   @db.Uuid
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  votacao   Votacao  @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
}

enum NotificacaoTipo {
  REACAO
  COMENTARIO
  MENCAO
  CBF_CITOU
  TROCA_DECIDIDA
  VOTACAO_RESULTADO
}

// Histórico do que a pessoa foi avisada (o push continua igual). Apagada após 60 dias pela limpeza.
model Notificacao {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @db.Uuid
  tipo         NotificacaoTipo
  atorId       String?         @db.Uuid
  postId       String?         @db.Uuid
  comentarioId String?         @db.Uuid
  votacaoId    String?         @db.Uuid
  trocaId      String?         @db.Uuid
  lidaEm       DateTime?
  createdAt    DateTime        @default(now())
  user         User            @relation("NotificacaoDestino", fields: [userId], references: [id], onDelete: Cascade)
  ator         User?           @relation("NotificacaoAtor", fields: [atorId], references: [id], onDelete: Cascade)
  post         Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  comentario   Comment?        @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  votacao      Votacao?        @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  troca        TransferRequest? @relation(fields: [trocaId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum StoryTipo {
  IMAGEM
  VIDEO
}

// Story: some em 24 h; a limpeza apaga a linha e os arquivos. Do clube (ou da CBF, pelo admin); autorId = quem postou.
model Story {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String
  autorId   String      @db.Uuid
  tipo      StoryTipo
  path      String
  capaPath  String?
  duracaoS  Float?
  largura   Int
  altura    Int
  createdAt DateTime    @default(now())
  expiraEm  DateTime
  club      Club        @relation(fields: [clubId], references: [id])
  autor     User        @relation(fields: [autorId], references: [id], onDelete: Cascade)
  vistos    StoryVisto[]

  @@index([expiraEm])
}

model StoryVisto {
  storyId String   @db.Uuid
  userId  String   @db.Uuid
  vistoEm DateTime @default(now())
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId])
}

// Vídeo do post (no lugar das imagens): MP4 H.264 convertido no servidor, com capa JPG.
model PostVideo {
  postId   String @id @db.Uuid
  path     String
  capaPath String
  duracaoS Float
  largura  Int
  altura   Int
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}
