# Copie para .env e troque a senha. O .env nunca vai para o repo.
POSTGRES_USER=instamanager
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=instamanager
POSTGRES_PORT=5433
DATABASE_URL=postgresql://instamanager:troque-esta-senha@localhost:5433/instamanager

# Back (Nest)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:5173

# Seed (pnpm --filter back db:seed): código de convite inicial e e-mail do admin
INVITE_CODE=troque-o-convite
ADMIN_EMAIL=voce@exemplo.com

# Produção (atrás do Traefik/nginx): 1, senão o rate limit usa o IP do proxy
TRUST_PROXY=0

# MCP da CBF (POST /mcp): chave Bearer. Vazio = desligado (404). Gere com: openssl rand -hex 32
MCP_CHAVE=

# Push (Web Push/VAPID). Gere o par com: pnpm --filter back exec web-push generate-vapid-keys
# Sem as três, o push fica desligado (o resto do app funciona). Chave real só no .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
